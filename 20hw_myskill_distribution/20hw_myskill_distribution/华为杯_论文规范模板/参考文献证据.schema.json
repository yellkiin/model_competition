{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "正文实引文献的来源与用途证据",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "bibliography_files",
    "references"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "bibliography_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "reference_type",
          "sources",
          "usages"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "reference_type": {
            "enum": [
              "ordinary",
              "ai_tool"
            ]
          },
          "ai_disclosure": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tool_name",
              "version",
              "organization",
              "date"
            ],
            "properties": {
              "tool_name": {
                "const": "DeepSeek"
              },
              "version": {
                "const": "DeepSeek-V4.1-Flash"
              },
              "organization": {
                "const": "深度求索（DeepSeek）"
              },
              "date": {
                "const": "2026-09-23"
              }
            }
          },
          "sources": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "authority",
                "authority_reason",
                "capture_path",
                "capture_sha256",
                "receipt_path",
                "receipt_sha256",
                "format",
                "review"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^https?://"
                },
                "authority": {
                  "enum": [
                    "publisher",
                    "author",
                    "official",
                    "library",
                    "repository"
                  ]
                },
                "authority_reason": {
                  "type": "string",
                  "minLength": 20
                },
                "capture_path": {
                  "type": "string",
                  "minLength": 1
                },
                "capture_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "receipt_path": {
                  "type": "string",
                  "minLength": 1
                },
                "receipt_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "format": {
                  "enum": [
                    "html_meta",
                    "csl_json",
                    "field_quotes"
                  ]
                },
                "json_pointer": {
                  "type": "string"
                },
                "pdf_pages": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "field_quotes": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "value",
                        "quote"
                      ],
                      "properties": {
                        "value": {
                          "type": "string",
                          "minLength": 1
                        },
                        "quote": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                },
                "review": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "reviewed",
                    "tool_ref",
                    "observation"
                  ],
                  "properties": {
                    "reviewed": {
                      "type": "boolean"
                    },
                    "tool_ref": {
                      "type": "string"
                    },
                    "observation": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "usages": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "chapter_id",
                "body_excerpt",
                "relevance",
                "reviewed",
                "tool_ref"
              ],
              "properties": {
                "chapter_id": {
                  "type": "string",
                  "minLength": 1
                },
                "body_excerpt": {
                  "type": "string",
                  "minLength": 1
                },
                "source_excerpt": {
                  "type": "string",
                  "minLength": 1
                },
                "ai_output_excerpt": {
                  "type": "string",
                  "minLength": 1
                },
                "relevance": {
                  "type": "string",
                  "minLength": 1
                },
                "reviewed": {
                  "type": "boolean"
                },
                "tool_ref": {
                  "type": "string"
                },
                "record_path": {
                  "type": "string",
                  "minLength": 1
                },
                "record_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "record_excerpt": {
                  "type": "string",
                  "minLength": 8
                },
                "purpose": {
                  "const": "tool_disclosure"
                }
              }
            }
          },
          "manual_metadata": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "title",
              "authors",
              "year"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "year": {
                "type": "string",
                "minLength": 1
              },
              "container": {
                "type": "string",
                "minLength": 1
              },
              "volume": {
                "type": "string",
                "minLength": 1
              },
              "issue": {
                "type": "string",
                "minLength": 1
              },
              "pages": {
                "type": "string",
                "minLength": 1
              },
              "publisher": {
                "type": "string",
                "minLength": 1
              },
              "edition": {
                "type": "string",
                "minLength": 1
              },
              "doi": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "accessed": {
                "type": "string",
                "minLength": 1
              },
              "authors": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "usage_status": {
            "enum": [
              "template_only",
              "adopted"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "reference_type": {
                  "const": "ai_tool"
                }
              }
            },
            "then": {
              "required": [
                "ai_disclosure",
                "usage_status"
              ],
              "properties": {
                "sources": {
                  "minItems": 0,
                  "maxItems": 0
                },
                "usages": {
                  "minItems": 0,
                  "items": {
                    "required": [
                      "chapter_id",
                      "body_excerpt",
                      "ai_output_excerpt",
                      "relevance",
                      "reviewed",
                      "tool_ref",
                      "record_path",
                      "record_sha256",
                      "record_excerpt",
                      "purpose"
                    ]
                  }
                },
                "key": {
                  "const": "ai_tool_disclosure"
                }
              },
              "not": {
                "required": [
                  "manual_metadata"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "reference_type": {
                  "const": "ordinary"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "ai_disclosure"
                ]
              },
              "properties": {
                "sources": {
                  "minItems": 1
                },
                "usages": {
                  "minItems": 1,
                  "items": {
                    "required": [
                      "chapter_id",
                      "body_excerpt",
                      "source_excerpt",
                      "relevance",
                      "reviewed",
                      "tool_ref"
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
