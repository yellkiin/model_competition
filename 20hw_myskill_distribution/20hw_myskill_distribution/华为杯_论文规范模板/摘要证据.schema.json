{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "摘要逐问证据映射",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "questions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chapter_id",
          "statements"
        ],
        "properties": {
          "chapter_id": {
            "type": "string",
            "minLength": 1
          },
          "statements": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "text",
                "source_path",
                "source_sha256",
                "source_pointer"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "method",
                    "conclusion",
                    "value",
                    "validation"
                  ]
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "source_path": {
                  "type": "string",
                  "minLength": 1
                },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "source_pointer": {
                  "type": "string"
                },
                "decimal_places": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 4
                },
                "key": {
                  "type": "boolean"
                }
              }
            }
          }
        }
      }
    }
  }
}
