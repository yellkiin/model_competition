% 本文最长表为500行，统一装入一个对齐块，续表头由longtable分页输出。
\setcounter{LTchunksize}{1000}
\renewcommand{\AppendixAttachmentTableBegin}{%
  \begingroup
  \songti\fontsize{12pt}{18pt}\selectfont
  \renewcommand{\arraystretch}{1.18}%
  \setlength{\tabcolsep}{4pt}%
  \begin{longtable}{>{\centering\arraybackslash}p{1.0cm}p{3.0cm}p{10.0cm}}
