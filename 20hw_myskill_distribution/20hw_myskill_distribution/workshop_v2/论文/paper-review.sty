  \toprule 序号 & 文件或目录 & 主要内容 \\
  \midrule\endfirsthead
  \caption[]{附件文件及内容（续）}\\
  \toprule 序号 & 文件或目录 & 主要内容 \\
  \midrule\endhead
  \midrule\multicolumn{3}{r}{续下页}\\\endfoot
  \bottomrule\endlastfoot
}

% 批注A008/A031：共同过程及两类专门候选的伪代码。
