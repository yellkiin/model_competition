{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/huawei-cup/supporting-materials.schema.json",
  "title": "华为杯提交附件支撑材料清单",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_title",
    "package_status",
    "questions",
    "external_data",
    "external_data_note",
    "official_outputs",
    "readme_source",
    "additional_files",
    "category_descriptions"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "project_title": {
      "type": "string",
      "minLength": 1
    },
    "package_status": {
      "enum": [
        "draft",
        "complete"
      ]
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "external_data": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/externalData"
      }
    },
    "external_data_note": {
      "type": "string",
      "minLength": 1
    },
    "official_outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/officialOutput"
      }
    },
    "readme_source": {
      "type": "string",
      "minLength": 1
    },
    "additional_files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fileItem"
      }
    },
    "category_descriptions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "其他数据",
        "其他支撑材料"
      ],
      "properties": {
        "其他数据": {
          "type": "string",
          "minLength": 1
        },
        "其他支撑材料": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "fileItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "description",
        "package_path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "package_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
        }
      }
    },
    "runVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "command",
        "record_path",
        "verified_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "pass",
            "fail"
          ]
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "record_path": {
          "type": "string",
          "minLength": 1
        },
        "verified_at": {
          "type": "string"
        }
      }
    },
    "supplementaryMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "material_type",
        "description",
        "reason"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "material_type": {
          "enum": [
            "figure",
            "table"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "package_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "complete"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reproduction"
            ]
          }
        }
      ],
      "required": [
        "question_id",
        "title",
        "status",
        "entrypoint",
        "run_command",
        "source_files",
        "run_verification",
        "supplementary_materials",
        "supplementary_materials_note",
        "environment_doc",
        "summary",
        "package_command"
      ],
      "properties": {
        "question_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "draft",
            "complete"
          ]
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "run_command": {
          "type": "string",
          "minLength": 1
        },
        "source_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fileItem"
          }
        },
        "run_verification": {
          "$ref": "#/$defs/runVerification"
        },
        "reproduction": {
          "$ref": "#/$defs/reproduction"
        },
        "supplementary_materials": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/supplementaryMaterial"
          }
        },
        "supplementary_materials_note": {
          "type": "string",
          "minLength": 1
        },
        "appendix_code": {
          "description": "可选的附录关键代码人工覆写；省略或留空时由附录生成器从已登记源码自动筛选。",
          "type": "array",
          "items": {
            "$ref": "#/$defs/appendixCode"
          }
        },
        "environment_doc": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "package_command": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "model_selection": {
          "type": "string",
          "minLength": 1,
          "description": "工作区相对模型选择报告路径；共享workshop逐问/final强制，纯理论题也登记C类理由"
        }
      }
    },
    "reproduction": {
      "description": "完整问题必须提供。命令工作目录为独立提交副本中本问的源码目录；输出运行前不得存在。",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commands",
        "outputs"
      ],
      "properties": {
        "commands": {
          "type": "array",
          "minItems": 2,
          "allOf": [
            {
              "contains": {
                "properties": {
                  "purpose": {
                    "const": "solve"
                  }
                },
                "required": [
                  "purpose"
                ]
              }
            },
            {
              "contains": {
                "properties": {
                  "purpose": {
                    "const": "validate"
                  }
                },
                "required": [
                  "purpose"
                ]
              }
            }
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "purpose",
              "argv"
            ],
            "properties": {
              "purpose": {
                "enum": [
                  "prepare",
                  "solve",
                  "validate"
                ]
              },
              "argv": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "expected_path",
              "comparison"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
              },
              "expected_path": {
                "type": "string",
                "minLength": 1
              },
              "comparison": {
                "enum": [
                  "sha256",
                  "json"
                ]
              },
              "abs_tol": {
                "type": "number",
                "minimum": 0
              },
              "rel_tol": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "appendixCode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "firstline": {
          "type": "integer",
          "minimum": 1
        },
        "lastline": {
          "type": "integer",
          "minimum": 1
        },
        "firstnumber": {
          "type": "integer",
          "minimum": 1
        },
        "caption": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "externalData": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "data_id",
        "name",
        "description",
        "source",
        "accessed_at",
        "collection_method",
        "license_or_terms",
        "used_by",
        "files",
        "collection_scripts",
        "provenance_file"
      ],
      "properties": {
        "data_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "accessed_at": {
          "type": "string",
          "minLength": 1
        },
        "collection_method": {
          "type": "string",
          "minLength": 1
        },
        "license_or_terms": {
          "type": "string",
          "minLength": 1
        },
        "used_by": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/fileItem"
          }
        },
        "collection_scripts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileItem"
          }
        },
        "provenance_file": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "officialOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "description",
        "verification_path",
        "status",
        "package_path"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "verification_path": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "pending",
            "pass",
            "fail"
          ]
        },
        "package_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
        }
      }
    }
  }
}
