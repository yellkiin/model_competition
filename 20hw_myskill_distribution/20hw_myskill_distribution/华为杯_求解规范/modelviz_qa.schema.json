{
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "REVIEW_REQUIRED",
        "PASS",
        "FAIL"
      ]
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resource_dependencies": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "schema_version": {
              "const": "1.0"
            },
            "runtime": {
              "enum": [
                "codex",
                "claude"
              ]
            },
            "scope": {
              "const": "modelviz"
            },
            "files": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "schema_version",
            "runtime",
            "scope",
            "files",
            "digest"
          ],
          "additionalProperties": false
        }
      ]
    },
    "inputs": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "technical_failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "views": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "final",
              "grayscale",
              "vector_page",
              "comparison"
            ]
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "reviewed": {
            "type": "boolean"
          },
          "tool_ref": {
            "type": "string"
          },
          "observation": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "path",
          "sha256",
          "reviewed",
          "tool_ref",
          "observation"
        ],
        "additionalProperties": false
      }
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "scientific_validity": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "REVIEW_REQUIRED",
                "PASS",
                "FAIL"
              ]
            },
            "observation": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "observation"
          ],
          "additionalProperties": false
        },
        "reference_fidelity": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "REVIEW_REQUIRED",
                "PASS",
                "FAIL"
              ]
            },
            "observation": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "observation"
          ],
          "additionalProperties": false
        },
        "print_readability": {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "REVIEW_REQUIRED",
                "PASS",
                "FAIL"
              ]
            },
            "observation": {
              "type": "string"
            }
          },
          "required": [
            "status",
            "observation"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "scientific_validity",
        "reference_fidelity",
        "print_readability"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "status",
    "contract_sha256",
    "resource_dependencies",
    "inputs",
    "outputs",
    "technical_failures",
    "views",
    "dimensions"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
