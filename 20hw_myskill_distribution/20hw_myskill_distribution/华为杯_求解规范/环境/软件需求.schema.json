{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "capability": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "necessity": {
            "enum": [
              "required",
              "conditional",
              "optional"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "sources": {
            "type": "array",
            "items": {
              "enum": [
                "base",
                "problem",
                "data_format",
                "method",
                "rendering",
                "submission"
              ]
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "capability",
          "necessity",
          "enabled",
          "sources",
          "reason",
          "provider"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "requirements"
  ],
  "additionalProperties": false
}
