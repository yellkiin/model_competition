{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "持续候选发现与七维阶段记录",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "purpose", "event_log", "questions", "stages", "candidates", "final_review"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "purpose": {"enum": ["production", "demo"]},
    "event_log": {"type": "string", "minLength": 1},
    "questions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/question"}},
    "stages": {"type": "array", "items": {"$ref": "#/$defs/stage"}},
    "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}},
    "final_review": {"type": ["object", "null"], "properties": {
      "observation": {"type": "string"}, "files": {"$ref": "#/$defs/files"},
      "question_ids": {"$ref": "#/$defs/ids"}, "scopes": {"$ref": "#/$defs/ids"}
    }}
  },
  "$defs": {
    "ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "files": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}},
    "question": {
      "type": "object", "additionalProperties": false,
      "required": ["question_id", "problem_types", "type_reviews", "expected_stages", "completion_review"],
      "properties": {
        "question_id": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "problem_types": {"$ref": "#/$defs/ids"}, "type_reason": {"type": "string"},
        "type_reviews": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["problem_type", "risk_review", "evidence"], "properties": {
            "problem_type": {"type": "string"}, "risk_review": {"type": "string"}, "evidence": {"$ref": "#/$defs/files"}
          }}},
        "expected_stages": {"$ref": "#/$defs/ids"},
        "completion_review": {"type": ["object", "null"], "properties": {
          "observation": {"type": "string"}, "zero_remaining_reason": {"type": "string"}, "files": {"$ref": "#/$defs/files"}, "stage_ids": {"$ref": "#/$defs/ids"}, "scopes": {"$ref": "#/$defs/ids"}
        }}
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["dimension", "scientific_question", "decision", "reason", "evidence", "candidate_ids", "followup", "resolved", "reuse"],
      "properties": {
        "dimension": {"enum": ["data_structure", "processing_effect", "intermediate_mechanism", "solution_process", "final_result", "comparison_validation", "error_boundary"]},
        "scientific_question": {"type": "string"},
        "decision": {"enum": ["pending", "covered", "new_figure", "new_analysis", "text_table", "not_applicable", "blocked"]},
        "reason": {"type": "string"}, "evidence": {"$ref": "#/$defs/files"},
        "candidate_ids": {"$ref": "#/$defs/ids"}, "followup": {"type": "string"}, "resolved": {"type": "boolean"},
        "reuse": {"type": ["object", "null"], "properties": {
          "stage_id": {"type": "string"}, "dimension": {"type": "string"}, "checks_digest": {"type": "string"}
        }}
      }
    },
    "stage": {
      "type": "object", "additionalProperties": false,
      "required": ["stage_id", "question_id", "kind", "start_event", "completion_event", "evidence", "checks", "review_event"],
      "properties": {
        "stage_id": {"type": "string", "minLength": 1}, "question_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["data_processing", "feature_construction", "model_training", "optimization", "validation", "method_result_change"]},
        "start_event": {"type": "string"}, "completion_event": {"type": ["string", "null"]},
        "evidence": {"$ref": "#/$defs/files"}, "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}},
        "review_event": {"type": ["string", "null"]}, "supersedes": {"type": ["string", "null"]}
      }
    },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["figure_id", "question_id", "stage_id", "plan_path", "quality", "destination", "scientific_question", "selection_reason", "conclusion", "limitations", "recommended_section", "statistical_unit", "discovery_event"],
      "properties": {
        "figure_id": {"type": "string", "minLength": 1}, "question_id": {"type": "string", "minLength": 1},
        "stage_id": {"type": "string", "minLength": 1}, "plan_path": {"type": "string", "minLength": 1}, "discovery_event": {"type": "string"},
        "quality": {"enum": ["planned", "review_required", "qualified", "failed", "stale"]},
        "destination": {"enum": ["paper", "supplement", "reserve", "rejected"]},
        "scientific_question": {"type": "string"}, "selection_reason": {"type": "string"},
        "conclusion": {"type": "string"}, "limitations": {"type": "string"},
        "recommended_section": {"type": "string"}, "statistical_unit": {"type": "string"}
      }
    }
  }
}
