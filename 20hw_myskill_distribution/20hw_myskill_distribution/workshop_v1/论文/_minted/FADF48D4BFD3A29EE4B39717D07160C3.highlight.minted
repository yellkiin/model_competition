        \PYG{k}{elif} \PYG{n}{src} \PYG{o+ow}{in} \PYG{n}{op\PYGZus{}ids} \PYG{o+ow}{and} \PYG{n}{dst} \PYG{o+ow}{in} \PYG{n}{op\PYGZus{}ids} \PYG{o+ow}{and} \PYG{n}{src} \PYG{o}{!=} \PYG{n}{dst}\PYG{p}{:}
