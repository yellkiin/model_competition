        \PYG{n}{used\PYGZus{}ids}\PYG{o}{.}\PYG{n}{add}\PYG{p}{(}\PYG{n}{copy\PYGZus{}id}\PYG{p}{)}
        \PYG{n}{next\PYGZus{}op\PYGZus{}id} \PYG{o}{+=} \PYG{l+m+mi}{1}
        \PYG{k}{return} \PYG{n}{ddr\PYGZus{}id}\PYG{p}{,} \PYG{n}{copy\PYGZus{}id}
    \PYG{n}{tasks} \PYG{o}{=} \PYG{p}{\PYGZob{}\PYGZcb{}}
