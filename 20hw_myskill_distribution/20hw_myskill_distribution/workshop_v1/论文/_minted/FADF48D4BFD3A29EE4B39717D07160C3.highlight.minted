\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{\PYGZus{}build\PYGZus{}scene\PYGZus{}a\PYGZus{}tasks}\PYG{p}{(}\PYG{n}{graph\PYGZus{}json}\PYG{p}{,} \PYG{n}{plan}\PYG{p}{,} \PYG{n}{bandwidth}\PYG{p}{,} \PYG{n}{capacity}\PYG{p}{):}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}将每个子图封装为独立 Task，并为所有 Task 边界插入 DDR COPY。}

\PYG{l+s+sd}{    输入：原图/方案来自选手，故derive\PYGZus{}multicore\PYGZus{}plan负责入口校验；参数}
