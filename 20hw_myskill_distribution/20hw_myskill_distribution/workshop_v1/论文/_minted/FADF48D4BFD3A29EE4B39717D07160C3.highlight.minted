    \PYG{k}{for} \PYG{n}{task\PYGZus{}id} \PYG{o+ow}{in} \PYG{n}{plan\PYGZus{}view}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}subgraph\PYGZus{}ids\PYGZsq{}}\PYG{p}{]:}
        \PYG{n}{task\PYGZus{}op\PYGZus{}ids} \PYG{o}{=} \PYG{n+nb}{set}\PYG{p}{(}\PYG{n}{plan\PYGZus{}view}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}nodes\PYGZus{}by\PYGZus{}subgraph\PYGZsq{}}\PYG{p}{][}\PYG{n}{task\PYGZus{}id}\PYG{p}{])}
        \PYG{n}{ops} \PYG{o}{=} \PYG{p}{[}\PYG{n+nb}{dict}\PYG{p}{(}\PYG{n}{op\PYGZus{}by\PYGZus{}id}\PYG{p}{[}\PYG{n}{op\PYGZus{}id}\PYG{p}{])} \PYG{k}{for} \PYG{n}{op\PYGZus{}id} \PYG{o+ow}{in} \PYG{n+nb}{sorted}\PYG{p}{(}\PYG{n}{task\PYGZus{}op\PYGZus{}ids}\PYG{p}{)]}
        \PYG{n}{tensors}\PYG{p}{,} \PYG{n}{edges} \PYG{o}{=} \PYG{p}{[],} \PYG{p}{[]}
        \PYG{n}{local\PYGZus{}tensor\PYGZus{}ids} \PYG{o}{=} \PYG{n+nb}{set}\PYG{p}{()}

