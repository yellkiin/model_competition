    \PYG{n}{next\PYGZus{}op\PYGZus{}id} \PYG{o}{=} \PYG{n+nb}{max}\PYG{p}{([}\PYG{n}{op}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}id\PYGZsq{}}\PYG{p}{]} \PYG{k}{for} \PYG{n}{op} \PYG{o+ow}{in} \PYG{n}{graph\PYGZus{}json}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}ops\PYGZsq{}}\PYG{p}{]]} \PYG{o}{+} \PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{])} \PYG{o}{+} \PYG{l+m+mi}{1}
    \PYG{n}{next\PYGZus{}tensor\PYGZus{}id} \PYG{o}{=} \PYG{n+nb}{max}\PYG{p}{(}
        \PYG{p}{[}\PYG{n}{tensor}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}id\PYGZsq{}}\PYG{p}{]} \PYG{k}{for} \PYG{n}{tensor} \PYG{o+ow}{in} \PYG{n}{graph\PYGZus{}json}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}tensors\PYGZsq{}}\PYG{p}{]]} \PYG{o}{+} \PYG{p}{[}\PYG{l+m+mi}{10000}\PYG{p}{])} \PYG{o}{+} \PYG{l+m+mi}{1}
    \PYG{n}{used\PYGZus{}ids} \PYG{o}{=} \PYG{n+nb}{set}\PYG{p}{(}\PYG{n}{op\PYGZus{}by\PYGZus{}id}\PYG{p}{)} \PYG{o}{|} \PYG{n+nb}{set}\PYG{p}{(}\PYG{n}{tensor\PYGZus{}by\PYGZus{}id}\PYG{p}{)}

    \PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{new\PYGZus{}boundary\PYGZus{}ids}\PYG{p}{():}
        \PYG{c+c1}{\PYGZsh{} 原图两类ID已唯一；新ID同时避开两类已占用空间，不能只取各自max。}
        \PYG{k}{nonlocal} \PYG{n}{next\PYGZus{}op\PYGZus{}id}\PYG{p}{,} \PYG{n}{next\PYGZus{}tensor\PYGZus{}id}
        \PYG{k}{while} \PYG{n}{next\PYGZus{}tensor\PYGZus{}id} \PYG{o+ow}{in} \PYG{n}{used\PYGZus{}ids}\PYG{p}{:}
            \PYG{n}{next\PYGZus{}tensor\PYGZus{}id} \PYG{o}{+=} \PYG{l+m+mi}{1}
