            \PYG{n}{tids} \PYG{o}{=} \PYG{n}{out\PYGZus{}tids}\PYG{p}{[}\PYG{n}{op}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}id\PYGZsq{}}\PYG{p}{]]}
