\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{\PYGZus{}original\PYGZus{}tensor\PYGZus{}views}\PYG{p}{(}\PYG{n}{graph\PYGZus{}json}\PYG{p}{):}
    \PYG{n}{op\PYGZus{}ids} \PYG{o}{=} \PYG{p}{\PYGZob{}}\PYG{n}{op}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}id\PYGZsq{}}\PYG{p}{]} \PYG{k}{for} \PYG{n}{op} \PYG{o+ow}{in} \PYG{n}{graph\PYGZus{}json}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}ops\PYGZsq{}}\PYG{p}{]\PYGZcb{}}
    \PYG{n}{producers}\PYG{p}{,} \PYG{n}{consumers} \PYG{o}{=} \PYG{n}{defaultdict}\PYG{p}{(}\PYG{n+nb}{set}\PYG{p}{),} \PYG{n}{defaultdict}\PYG{p}{(}\PYG{n+nb}{set}\PYG{p}{)}
    \PYG{n}{direct\PYGZus{}edges} \PYG{o}{=} \PYG{p}{[]}
    \PYG{k}{for} \PYG{n}{edge} \PYG{o+ow}{in} \PYG{n}{graph\PYGZus{}json}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}edges\PYGZsq{}}\PYG{p}{]:}
