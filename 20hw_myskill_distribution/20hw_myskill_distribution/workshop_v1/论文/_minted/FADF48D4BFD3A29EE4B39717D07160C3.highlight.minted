\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{n}{plan\PYGZus{}view} \PYG{o}{=} \PYG{n}{derive\PYGZus{}multicore\PYGZus{}plan}\PYG{p}{(}\PYG{n}{graph\PYGZus{}json}\PYG{p}{,} \PYG{n}{plan}\PYG{p}{)}
