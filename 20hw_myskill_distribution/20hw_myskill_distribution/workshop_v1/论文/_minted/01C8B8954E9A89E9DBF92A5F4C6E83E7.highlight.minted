            \PYG{k}{for} \PYG{n}{op} \PYG{o+ow}{in} \PYG{n}{core}\PYG{o}{.}\PYG{n}{get}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}ops\PYGZsq{}}\PYG{p}{,} \PYG{p}{[]):}
                \PYG{n}{sg} \PYG{o}{=} \PYG{n}{op}\PYG{o}{.}\PYG{n}{get}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}subgraph\PYGZus{}id\PYGZsq{}}\PYG{p}{,} \PYG{n}{op}\PYG{o}{.}\PYG{n}{get}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}task\PYGZus{}id\PYGZsq{}}\PYG{p}{))}
                \PYG{k}{if} \PYG{n}{sg} \PYG{o+ow}{is} \PYG{k+kc}{None}\PYG{p}{:}
