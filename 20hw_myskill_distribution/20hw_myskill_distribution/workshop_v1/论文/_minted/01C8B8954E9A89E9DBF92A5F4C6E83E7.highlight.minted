\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{\PYGZus{}trace\PYGZus{}json}\PYG{p}{(}\PYG{n}{filename}\PYG{p}{,} \PYG{n}{result}\PYG{p}{):}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}把操作时间线转换为 Perfetto/Chrome 可以打开的 Trace JSON。\PYGZdq{}\PYGZdq{}\PYGZdq{}}
    \PYG{n}{events} \PYG{o}{=} \PYG{p}{[]}
    \PYG{n}{pipe\PYGZus{}order} \PYG{o}{=} \PYG{p}{\PYGZob{}}\PYG{l+s+s1}{\PYGZsq{}PIPE\PYGZus{}MTE2\PYGZsq{}}\PYG{p}{:} \PYG{l+m+mi}{0}\PYG{p}{,} \PYG{l+s+s1}{\PYGZsq{}PIPE\PYGZus{}MTE3\PYGZsq{}}\PYG{p}{:} \PYG{l+m+mi}{1}\PYG{p}{,} \PYG{l+s+s1}{\PYGZsq{}PIPE\PYGZus{}M\PYGZsq{}}\PYG{p}{:} \PYG{l+m+mi}{2}\PYG{p}{,} \PYG{l+s+s1}{\PYGZsq{}PIPE\PYGZus{}V\PYGZsq{}}\PYG{p}{:} \PYG{l+m+mi}{3}\PYG{p}{\PYGZcb{}}
    \PYG{c+c1}{\PYGZsh{} Use one Perfetto process track per core.  Without explicit metadata the}
    \PYG{c+c1}{\PYGZsh{} UI labels numeric tids as generic ``Thread`` tracks and loses the core /}
    \PYG{c+c1}{\PYGZsh{} pipe hierarchy.}
    \PYG{n}{pid\PYGZus{}base} \PYG{o}{=} \PYG{l+m+mi}{1000}
    \PYG{k}{for} \PYG{n}{core} \PYG{o+ow}{in} \PYG{n}{result}\PYG{o}{.}\PYG{n}{get}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}per\PYGZus{}core\PYGZus{}timeline\PYGZsq{}}\PYG{p}{,} \PYG{p}{[]):}
