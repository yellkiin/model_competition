        \PYG{n}{pid} \PYG{o}{=} \PYG{n}{pid\PYGZus{}base} \PYG{o}{+} \PYG{n}{core\PYGZus{}id}
        \PYG{n}{events}\PYG{o}{.}\PYG{n}{append}\PYG{p}{(\PYGZob{}}\PYG{l+s+s1}{\PYGZsq{}name\PYGZsq{}}\PYG{p}{:} \PYG{l+s+s1}{\PYGZsq{}process\PYGZus{}name\PYGZsq{}}\PYG{p}{,} \PYG{l+s+s1}{\PYGZsq{}ph\PYGZsq{}}\PYG{p}{:} \PYG{l+s+s1}{\PYGZsq{}M\PYGZsq{}}\PYG{p}{,} \PYG{l+s+s1}{\PYGZsq{}pid\PYGZsq{}}\PYG{p}{:} \PYG{n}{pid}\PYG{p}{,} \PYG{l+s+s1}{\PYGZsq{}tid\PYGZsq{}}\PYG{p}{:} \PYG{l+m+mi}{0}\PYG{p}{,}
                       \PYG{l+s+s1}{\PYGZsq{}args\PYGZsq{}}\PYG{p}{:} \PYG{p}{\PYGZob{}}\PYG{l+s+s1}{\PYGZsq{}name\PYGZsq{}}\PYG{p}{:} \PYG{l+s+s1}{\PYGZsq{}Core }\PYG{l+s+si}{\PYGZob{}\PYGZcb{}}\PYG{l+s+s1}{\PYGZsq{}}\PYG{o}{.}\PYG{n}{format}\PYG{p}{(}\PYG{n}{core\PYGZus{}id}\PYG{p}{)\PYGZcb{}\PYGZcb{})}
        \PYG{k}{for} \PYG{n}{pipe}\PYG{p}{,} \PYG{n}{index} \PYG{o+ow}{in} \PYG{n}{pipe\PYGZus{}order}\PYG{o}{.}\PYG{n}{items}\PYG{p}{():}
            \PYG{n}{events}\PYG{o}{.}\PYG{n}{append}\PYG{p}{(\PYGZob{}}\PYG{l+s+s1}{\PYGZsq{}name\PYGZsq{}}\PYG{p}{:} \PYG{l+s+s1}{\PYGZsq{}thread\PYGZus{}name\PYGZsq{}}\PYG{p}{,} \PYG{l+s+s1}{\PYGZsq{}ph\PYGZsq{}}\PYG{p}{:} \PYG{l+s+s1}{\PYGZsq{}M\PYGZsq{}}\PYG{p}{,} \PYG{l+s+s1}{\PYGZsq{}pid\PYGZsq{}}\PYG{p}{:} \PYG{n}{pid}\PYG{p}{,}
                           \PYG{l+s+s1}{\PYGZsq{}tid\PYGZsq{}}\PYG{p}{:} \PYG{n}{index}\PYG{p}{,} \PYG{l+s+s1}{\PYGZsq{}args\PYGZsq{}}\PYG{p}{:} \PYG{p}{\PYGZob{}}\PYG{l+s+s1}{\PYGZsq{}name\PYGZsq{}}\PYG{p}{:} \PYG{n}{pipe}\PYG{p}{\PYGZcb{}\PYGZcb{})}
    \PYG{k}{for} \PYG{n}{core} \PYG{o+ow}{in} \PYG{n}{result}\PYG{o}{.}\PYG{n}{get}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}per\PYGZus{}core\PYGZus{}timeline\PYGZsq{}}\PYG{p}{,} \PYG{p}{[]):}
        \PYG{n}{core\PYGZus{}id} \PYG{o}{=} \PYG{n}{core}\PYG{p}{[}\PYG{l+s+s1}{\PYGZsq{}core\PYGZus{}id\PYGZsq{}}\PYG{p}{]}
        \PYG{n}{pid} \PYG{o}{=} \PYG{n}{pid\PYGZus{}base} \PYG{o}{+} \PYG{n}{core\PYGZus{}id}
        \PYG{c+c1}{\PYGZsh{} Evaluators already publish task/subgraph spans. Keep them as their}
        \PYG{c+c1}{\PYGZsh{} own category so the core process can be collapsed/expanded while}
        \PYG{c+c1}{\PYGZsh{} the four pipe tracks remain visible underneath it.}
        \PYG{n}{subgraphs} \PYG{o}{=} \PYG{n}{core}\PYG{o}{.}\PYG{n}{get}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}subgraphs\PYGZsq{}}\PYG{p}{,} \PYG{p}{[])}
