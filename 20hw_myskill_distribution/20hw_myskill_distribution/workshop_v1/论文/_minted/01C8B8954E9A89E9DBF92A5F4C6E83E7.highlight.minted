    \PYG{k}{for} \PYG{n}{core} \PYG{o+ow}{in} \PYG{n}{result}\PYG{o}{.}\PYG{n}{get}\PYG{p}{(}\PYG{l+s+s1}{\PYGZsq{}per\PYGZus{}core\PYGZus{}timeline\PYGZsq{}}\PYG{p}{,} \PYG{p}{[]):}
