# Keep supplied problem files byte-for-byte, including original line endings.
/题目/** -text

# Store raw binary and corpus data using Git LFS; no history rewrite required.
/题目/**/*.pkl filter=lfs diff=lfs merge=lfs -text
/题目/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
/题目/**/*.mat filter=lfs diff=lfs merge=lfs -text
/题目/**/*.tif filter=lfs diff=lfs merge=lfs -text
/题目/**/*.parquet filter=lfs diff=lfs merge=lfs -text
/题目/**/*.jsonl filter=lfs diff=lfs merge=lfs -text
/题目/A题/**/data/*.json filter=lfs diff=lfs merge=lfs -text
/data-parts/**/*.bin filter=lfs diff=lfs merge=lfs -text

# Keep authored research and tooling consistent across platforms.
/调研/** text eol=lf
/tools/** text eol=lf
/README.md text eol=lf
/.gitignore text eol=lf
/.gitattributes text eol=lf
